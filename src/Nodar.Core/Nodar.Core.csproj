<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lógica do Nodar sem interface: descoberta, serviços, vulnerabilidades, histórico e relatórios. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nodar.Core</RootNamespace>
    <AssemblyName>Nodar.Core</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nodar.Tests" />
  </ItemGroup>

</Project>
