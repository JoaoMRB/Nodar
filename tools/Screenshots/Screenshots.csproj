<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gera os screenshots do README a partir do modo demonstração, renderizando fora do ecrã (headless).
       Instruções de uso em Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nodar.App\Nodar.App.csproj" />
  </ItemGroup>

</Project>
